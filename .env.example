DATABASE_URL="postgresql://gameswap:replace-me@localhost:5432/gameswap?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION="false"
NEXT_PUBLIC_ENABLE_DEMO_CATALOG="false"
EMAIL_DELIVERY_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM="GameSwap <support@example.com>"

# Twilio Verify SMS. Create a Verify Service; do not use a Messaging sender number here.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Stripe Connect. Keep test and live keys in separate deployment environments.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_CONNECT_COUNTRY="US"
STRIPE_CURRENCY="usd"

# Private S3-compatible object storage for ticket and dispute evidence.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Real event catalog. Use manual for admin-created events or ticketmaster with a real API key.
EVENT_SOURCE="manual"
TICKETMASTER_API_KEY=""

# Comma-separated bootstrap admins. Roles must still be persisted in the database.
ADMIN_EMAILS=""
LOG_LEVEL="info"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
